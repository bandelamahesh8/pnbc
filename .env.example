# Pragati Bharati - Document Intelligence & Question Extraction Service
# Environment Configuration

# Project
PROJECT_NAME="Pragati Bharati - Document Intelligence & Question Extraction Service"
API_V1_STR="/api/v1"

# Security (Change in production!)
SECRET_KEY="generate-a-strong-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is SQLite for fast local development / testing without external dependencies.
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pnbc_doc_intel"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/pnbc_doc_intel"
DATABASE_URL="sqlite+aiosqlite:///./pnbc.db"
SYNC_DATABASE_URL="sqlite:///./pnbc.db"

# Redis & Celery (Set CELERY_ENABLED=True for distributed Redis workers)
REDIS_URL="redis://localhost:6379/0"
CELERY_ENABLED=False

# Google Gemini API (Set your API key for multimodal vision extraction)
# If left unset, the system uses its built-in local deterministic extraction engine
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# File Storage
STORAGE_DIR="data/uploads"
MAX_UPLOAD_SIZE_MB=50

# Confidence Thresholds
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_REVIEW=0.70
